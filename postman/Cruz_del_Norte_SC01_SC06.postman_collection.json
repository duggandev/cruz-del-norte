    {
      "name": "01 - SC-01 Disponibilidad Viajes",
      "item": [
        {
          "name": "200 OK - Consultar viajes existentes",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Status code es 200', () => pm.response.to.have.status(200));",
            "pm.test('Content-Type es JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
            "const body = pm.response.json();",
            "pm.test('Retorna lista de viajes', () => pm.expect(body.viajes).to.be.an('array').that.is.not.empty);",
            "const v = body.viajes[0];",
            "pm.test('Hay al menos dos asientos disponibles', () => pm.expect(v.asientosDisponibles.length).to.be.above(1));",
            "pm.collectionVariables.set('idViaje', v.idViaje); pm.collectionVariables.set('importe', v.tarifa);",
            "pm.collectionVariables.set('idAsiento', v.asientosDisponibles[v.asientosDisponibles.length - 1]); pm.collectionVariables.set('idAsientoLiberacion', v.asientosDisponibles[v.asientosDisponibles.length - 2]);"
          ]}}],
          "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/viajes/disponibilidad?origen=Lima&destino=Ica&fecha=2026-12-01"}
        },
        {
          "name": "200 OK - Consultar mapa y precios de asientos",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status code es 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.test('Incluye configuracion de columnas por piso', () => { pm.expect(body).to.have.property('tarifaBase'); pm.expect(body).to.have.property('tipoBus'); pm.expect(body).to.have.property('pisos'); pm.expect(body).to.have.property('capacidad'); pm.expect(body).to.have.property('columnasPorPiso'); pm.expect(body.asientos).to.be.an('array').that.is.not.empty; });", "const seat = body.asientos.find(a => a.estado === 'DISPONIBLE');", "pm.expect(seat).to.exist;", "pm.expect(seat).to.have.property('piso'); pm.expect(seat).to.have.property('fila'); pm.expect(seat).to.have.property('columnaNumero'); pm.expect(seat).to.have.property('columnas'); pm.expect(seat).to.have.property('precio');", "pm.collectionVariables.set('idViaje', body.idViaje); pm.collectionVariables.set('idAsiento', seat.idAsiento); pm.collectionVariables.set('tipoAsiento', seat.tipo); pm.collectionVariables.set('importe', seat.precio);"]}}],
          "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/viajes/{{idViaje}}/asientos"}
        },
