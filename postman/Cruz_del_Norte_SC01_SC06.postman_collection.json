      "item": [
        {
          "name": "200 OK - Login y generar token VENTAS",
          "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"usuario\": \"ventas\",\n  \"password\": \"ventas-demo\"\n}"},"url":"{{baseUrl}}/api/v1/auth/login"},
          "event": [{"listen":"test","script":{"exec":["pm.test('Login exitoso', () => pm.response.to.have.status(200));","const body = pm.response.json();","pm.expect(body.access_token).to.be.a('string').and.not.empty;","pm.collectionVariables.set('token', body.access_token);","if (pm.environment) pm.environment.set('token', body.access_token);"]}}]
        },
        {
          "name": "200 OK - Generar token académico y comprobar Gateway",
          "event": [
            {"listen": "prerequest", "script": {"exec": [
              "const jwtSecret = pm.variables.get('jwtSecret');",
              "if (!jwtSecret) { throw new Error('Configure jwtSecret con el mismo JWT_SECRET_KEY de Coolify antes de ejecutar la colección.'); }",
              "const cryptoJsLib = require('crypto-js');",
              "const base64url = value => cryptoJsLib.enc.Base64.stringify(value).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "const now = Math.floor(Date.now() / 1000);",
              "const header = base64url(cryptoJsLib.enc.Utf8.parse(JSON.stringify({alg: 'HS256', typ: 'JWT'})));",
              "const payload = base64url(cryptoJsLib.enc.Utf8.parse(JSON.stringify({sub: 'postman-runner', roles: ['ADMIN'], iat: now, exp: now + 7200})));",
              "const signature = base64url(cryptoJsLib.HmacSHA256(header + '.' + payload, jwtSecret));",
              "const generatedToken = header + '.' + payload + '.' + signature;",
              "pm.collectionVariables.set('token', generatedToken);",
              "if (pm.environment) { pm.environment.set('token', generatedToken); }",
              "['idViaje','idAsiento','idAsientoLiberacion','importe','idReserva','idReservaLiberacion','idTransaccion','idTransaccionRechazada','idTransaccionPendiente','documentoUrl'].forEach(k => pm.collectionVariables.unset(k));",
              "pm.collectionVariables.set('idemRechazado', 'rechazado-' + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('idemPendiente', 'pendiente-' + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('idemAprobado', 'aprobado-' + pm.variables.replaceIn('{{$guid}}'));"
            ]}},
            {"listen": "test", "script": {"exec": [
              "pm.test('Status code es 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type es JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Gateway reporta estado ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
              "pm.test('Token JWT generado y guardado', () => pm.expect(pm.collectionVariables.get('token').split('.')).to.have.lengthOf(3));"
            ]}}
          ],
          "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{baseUrl}}/health"}
        },
        {
          "name": "200 OK - OpenAPI SC-01 disponible",
