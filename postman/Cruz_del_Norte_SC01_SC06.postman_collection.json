{
  "info": {
    "name": "Cruz del Norte - SC-01 a SC-06",
    "description": "Colección integral para el Gateway y los seis servicios. Ejecute las solicitudes en el orden definido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
  "variable": [
    {"key": "baseUrl", "value": "https://cruzdelnorte.duckdns.org"},
    {"key": "token", "value": ""},
    {"key": "idViaje", "value": ""},
    {"key": "idAsiento", "value": ""},
    {"key": "idAsientoLiberacion", "value": ""},
    {"key": "importe", "value": ""},
    {"key": "idReserva", "value": ""},
    {"key": "idReservaLiberacion", "value": ""},
    {"key": "idTransaccion", "value": ""},
    {"key": "idTransaccionRechazada", "value": ""},
    {"key": "idTransaccionPendiente", "value": ""},
    {"key": "documentoUrl", "value": ""},
    {"key": "idemRechazado", "value": ""},
    {"key": "idemPendiente", "value": ""},
    {"key": "idemAprobado", "value": ""}
  ],
  "item": [
    {
      "name": "00 - Infraestructura y OpenAPI",
      "item": [
        {
          "name": "Gateway health",
          "event": [
            {"listen": "prerequest", "script": {"exec": [
              "['idViaje','idAsiento','idAsientoLiberacion','importe','idReserva','idReservaLiberacion','idTransaccion','idTransaccionRechazada','idTransaccionPendiente','documentoUrl'].forEach(k => pm.collectionVariables.unset(k));",
              "pm.collectionVariables.set('idemRechazado', 'rechazado-' + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('idemPendiente', 'pendiente-' + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('idemAprobado', 'aprobado-' + pm.variables.replaceIn('{{$guid}}'));"
            ]}},
            {"listen": "test", "script": {"exec": ["pm.test('Gateway saludable', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"]}}
          ],
          "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{baseUrl}}/health"}
        },
        {"name": "OpenAPI SC-01", "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{baseUrl}}/openapi/sc01.json"}},
        {"name": "OpenAPI SC-02", "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{baseUrl}}/openapi/sc02.json"}},
        {"name": "OpenAPI SC-03", "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{baseUrl}}/openapi/sc03.json"}},
        {"name": "OpenAPI SC-04", "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{baseUrl}}/openapi/sc04.json"}},
        {"name": "OpenAPI SC-05", "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{baseUrl}}/openapi/sc05.json"}},
        {"name": "OpenAPI SC-06", "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{baseUrl}}/openapi/sc06.json"}}
      ]
    },
    {
      "name": "01 - SC-01 Disponibilidad",
      "item": [{
        "name": "Consultar viajes",
        "event": [{"listen": "test", "script": {"exec": [
          "pm.test('Disponibilidad disponible', () => pm.expect([200,203]).to.include(pm.response.code));",
          "const v = pm.response.json().viajes[0]; pm.expect(v.asientosDisponibles.length).to.be.above(1);",
          "pm.collectionVariables.set('idViaje', v.idViaje); pm.collectionVariables.set('importe', v.tarifa);",
          "pm.collectionVariables.set('idAsiento', v.asientosDisponibles[v.asientosDisponibles.length - 1]); pm.collectionVariables.set('idAsientoLiberacion', v.asientosDisponibles[v.asientosDisponibles.length - 2]);"
        ]}}],
        "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/viajes/disponibilidad?origen=Lima&destino=Ica&fecha=2026-12-01"}
      }]
    },
    {
      "name": "02 - SC-03 Pasajeros",
      "item": [{
        "name": "Validar pasajero",
        "event": [{"listen": "test", "script": {"exec": ["pm.test('Validación académica', () => { pm.response.to.have.status(203); pm.expect(pm.response.json().resultado).to.eql('CONFORME'); });"]}}],
        "request": {
          "method": "POST",
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": {"mode": "raw", "raw": "{\n  \"dni\": \"74859621\",\n  \"nombres\": \"Prueba\",\n  \"apellidos\": \"Postman VPS\",\n  \"correo\": \"prueba@example.com\"\n}"},
          "url": "{{baseUrl}}/api/v1/pasajeros/validaciones"
        }
      }]
    },
    {
      "name": "03 - SC-02 Reservas",
      "item": [
        {
          "name": "Crear reserva principal",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Reserva creada', () => pm.response.to.have.status(201)); pm.collectionVariables.set('idReserva', pm.response.json().idReserva);"]}}],
          "request": {
            "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"idViaje\": {{idViaje}},\n  \"idAsiento\": {{idAsiento}},\n  \"idCanal\": 1,\n  \"pasajero\": {\"dni\": \"74859621\", \"nombres\": \"Prueba\", \"apellidos\": \"Postman VPS\"}\n}"},
            "url": "{{baseUrl}}/api/v1/reservas"
          }
        },
        {
          "name": "Crear reserva para liberar",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Reserva auxiliar creada', () => pm.response.to.have.status(201)); pm.collectionVariables.set('idReservaLiberacion', pm.response.json().idReserva);"]}}],
          "request": {
            "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"idViaje\": {{idViaje}},\n  \"idAsiento\": {{idAsientoLiberacion}},\n  \"idCanal\": 1,\n  \"pasajero\": {\"dni\": \"74859622\", \"nombres\": \"Prueba\", \"apellidos\": \"Liberación\"}\n}"},
            "url": "{{baseUrl}}/api/v1/reservas"
          }
        },
        {
          "name": "Liberar reserva",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Reserva liberada', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().estado).to.eql('CANCELADA'); });"]}}],
          "request": {"method": "POST", "url": "{{baseUrl}}/api/v1/reservas/{{idReservaLiberacion}}/liberacion"}
        }
      ]
    },
    {
      "name": "04 - SC-04 Pagos mock",
      "item": [
        {
          "name": "Pago rechazado",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Pago rechazado', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().estado).to.eql('RECHAZADO'); }); pm.collectionVariables.set('idTransaccionRechazada', pm.response.json().idTransaccion);"]}}],
          "request": {
            "method": "POST", "header": [{"key": "Idempotency-Key", "value": "{{idemRechazado}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"idReserva\": {{idReserva}},\n  \"importe\": {{importe}},\n  \"medioPago\": \"PASARELA\",\n  \"tokenPasarela\": \"mock_rechazado\"\n}"},
            "url": "{{baseUrl}}/api/v1/pagos"
          }
        },
        {
          "name": "Pago pendiente",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Pago pendiente', () => { pm.response.to.have.status(202); pm.expect(pm.response.json().estado).to.eql('PENDIENTE'); }); pm.collectionVariables.set('idTransaccionPendiente', pm.response.json().idTransaccion);"]}}],
          "request": {
            "method": "POST", "header": [{"key": "Idempotency-Key", "value": "{{idemPendiente}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"idReserva\": {{idReserva}},\n  \"importe\": {{importe}},\n  \"medioPago\": \"PASARELA\",\n  \"tokenPasarela\": \"mock_pendiente\"\n}"},
            "url": "{{baseUrl}}/api/v1/pagos"
          }
        },
        {
          "name": "Error simulado",
          "event": [{"listen": "prerequest", "script": {"exec": ["pm.variables.set('idemError', 'error-' + pm.variables.replaceIn('{{$guid}}'));"]}}, {"listen": "test", "script": {"exec": ["pm.test('Error controlado', () => pm.response.to.have.status(502));"]}}],
          "request": {
            "method": "POST", "header": [{"key": "Idempotency-Key", "value": "{{idemError}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"idReserva\": {{idReserva}},\n  \"importe\": {{importe}},\n  \"medioPago\": \"PASARELA\",\n  \"tokenPasarela\": \"mock_error\"\n}"},
            "url": "{{baseUrl}}/api/v1/pagos"
          }
        },
        {
          "name": "Timeout simulado",
          "event": [{"listen": "prerequest", "script": {"exec": ["pm.variables.set('idemTimeout', 'timeout-' + pm.variables.replaceIn('{{$guid}}'));"]}}, {"listen": "test", "script": {"exec": ["pm.test('Timeout controlado', () => pm.response.to.have.status(504));"]}}],
          "request": {
            "method": "POST", "header": [{"key": "Idempotency-Key", "value": "{{idemTimeout}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"idReserva\": {{idReserva}},\n  \"importe\": {{importe}},\n  \"medioPago\": \"PASARELA\",\n  \"tokenPasarela\": \"mock_timeout\"\n}"},
            "url": "{{baseUrl}}/api/v1/pagos"
          }
        },
        {
          "name": "Pago aprobado",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Pago aprobado', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().estado).to.eql('APROBADO'); pm.expect(pm.response.json().idTransaccion).to.match(/^MOCK-/); });",
            "pm.collectionVariables.set('idTransaccion', pm.response.json().idTransaccion);"
          ]}}],
          "request": {
            "method": "POST", "header": [{"key": "Idempotency-Key", "value": "{{idemAprobado}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"idReserva\": {{idReserva}},\n  \"importe\": {{importe}},\n  \"medioPago\": \"PASARELA\",\n  \"tokenPasarela\": \"mock_aprobado\"\n}"},
            "url": "{{baseUrl}}/api/v1/pagos"
          }
        },
        {
          "name": "Reintento idempotente",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Misma transacción', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().idTransaccion).to.eql(pm.collectionVariables.get('idTransaccion')); });"]}}],
          "request": {
            "method": "POST", "header": [{"key": "Idempotency-Key", "value": "{{idemAprobado}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"idReserva\": {{idReserva}},\n  \"importe\": {{importe}},\n  \"medioPago\": \"PASARELA\",\n  \"tokenPasarela\": \"mock_aprobado\"\n}"},
            "url": "{{baseUrl}}/api/v1/pagos"
          }
        },
        {
          "name": "Reutilización incorrecta de clave",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Conflicto esperado', () => pm.response.to.have.status(409));"]}}],
          "request": {
            "method": "POST", "header": [{"key": "Idempotency-Key", "value": "{{idemAprobado}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"idReserva\": {{idReserva}},\n  \"importe\": {{importe}},\n  \"medioPago\": \"PASARELA\",\n  \"tokenPasarela\": \"mock_rechazado\"\n}"},
            "url": "{{baseUrl}}/api/v1/pagos"
          }
        }
      ]
    },
    {
      "name": "05 - SC-05 Pasajes",
      "item": [
        {
          "name": "Impedir emisión con pago rechazado",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Pago rechazado no emite pasaje', () => pm.response.to.have.status(422));"]}}],
          "request": {
            "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"idReserva\": {{idReserva}},\n  \"idTransaccion\": \"{{idTransaccionRechazada}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/pasajes"
          }
        },
        {
          "name": "Impedir emisión con pago pendiente",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Pago pendiente no emite pasaje', () => pm.response.to.have.status(422));"]}}],
          "request": {
            "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"idReserva\": {{idReserva}},\n  \"idTransaccion\": \"{{idTransaccionPendiente}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/pasajes"
          }
        },
        {
          "name": "Emitir pasaje",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Pasaje emitido', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().estado).to.eql('EMITIDO'); }); pm.collectionVariables.set('documentoUrl', pm.response.json().documentoUrl);"]}}],
          "request": {
            "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"idReserva\": {{idReserva}},\n  \"idTransaccion\": \"{{idTransaccion}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/pasajes"
          }
        },
        {
          "name": "Descargar PDF",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('PDF disponible', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'); });"]}}],
          "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{documentoUrl}}"}
        }
      ]
    },
    {
      "name": "06 - SC-06 Mantenimiento",
      "item": [{
        "name": "Programar mantenimiento",
        "event": [
          {"listen": "prerequest", "script": {"exec": [
            "const d = new Date(); d.setUTCDate(d.getUTCDate() + 700 + Math.floor(Math.random() * 200));",
            "pm.variables.set('fechaMantenimiento', d.toISOString().slice(0,10)); pm.variables.set('idVehiculo', 101 + Math.floor(Math.random() * 59));"
          ]}},
          {"listen": "test", "script": {"exec": ["pm.test('Mantenimiento programado', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().estado).to.eql('PROGRAMADO'); });"]}}
        ],
        "request": {
          "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": {"mode": "raw", "raw": "{\n  \"idVehiculo\": {{idVehiculo}},\n  \"kilometraje\": 87500,\n  \"fecha\": \"{{fechaMantenimiento}}\",\n  \"tipo\": \"PREVENTIVO\"\n}"},
          "url": "{{baseUrl}}/api/v1/programaciones"
        }
      }]
    }
  ]
}
